---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import { Image } from 'astro:assets';
import { crayons } from '../utils/rating';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const [featured, ...rest] = posts;
const money = rest.filter((post) => post.data.type === 'money');
const reviews = rest.filter((post) => post.data.type === 'review');
const notes = rest.filter((post) => post.data.type === 'post');

const chip = (post: (typeof posts)[number]) =>
  post.data.type === 'review'
    ? { class: 'chip chip-review', label: 'Gear Review' }
    : post.data.type === 'money'
      ? { class: 'chip chip-money', label: 'Money Note' }
      : { class: 'chip chip-note', label: 'Note' };
---

<BaseLayout title="Baby Gear Reviews & Money Notes for Working Parents">
  <section class="hero">
    <h1>
      Honest notes on gear, money, and the everyday, <em>for parents, in soft colors.</em>
    </h1>
    <p class="hero-intro">
      Honest gear teardowns, money notes for parents who work for themselves, and quiet
      notes on the everyday - from a family of two kids, one dog, and one small business.
    </p>
  </section>

  {featured && (
    <a class="featured-card" href={`/posts/${featured.id}/`}>
      <span class="featured-media">
        {featured.data.cover && (
          <Image
            src={featured.data.cover}
            alt={featured.data.coverAlt || ''}
            width={1200}
            height={750}
            loading="eager"
          />
        )}
      </span>
      <span class="featured-body">
        <span class={chip(featured).class}>{chip(featured).label}</span>
        <span class="featured-date"><FormattedDate date={featured.data.pubDate} /></span>
        <span class="featured-title">{featured.data.title}</span>
        {featured.data.description && (
          <span class="featured-desc">{featured.data.description}</span>
        )}
        <span class="featured-cta">
          {featured.data.type === 'review' ? 'Read the review' : 'Read the note'} <span aria-hidden="true">→</span>
        </span>
      </span>
    </a>
  )}

  {money.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Money Notes</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <a class="tool-banner" href="/tools/trump-account-calculator/">
        <span class="tool-banner-label">New tool</span>
        <span class="tool-banner-text">Trump Account Calculator: see what the $1,000 becomes by 18, 21, and 30</span>
        <span class="tool-banner-cta" aria-hidden="true">→</span>
      </a>
      <ul class="post-grid">
        {money.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.id}/`}>
              <span class="card-media">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt={post.data.coverAlt || ''}
                    width={640}
                    height={400}
                    loading="lazy"
                  />
                )}
              </span>
              <span class="card-body">
                <span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
                <span class="card-title">{post.data.title}</span>
                {post.data.description && <span class="card-desc">{post.data.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Baby Gear Reviews</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="post-grid">
        {reviews.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.id}/`}>
              <span class="card-media">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt={post.data.coverAlt || ''}
                    width={640}
                    height={400}
                    loading="lazy"
                  />
                )}
              </span>
              <span class="card-body">
                <span class="card-date">
                  <FormattedDate date={post.data.pubDate} />
                  {typeof post.data.rating === 'number' && (
                    <span> · {crayons(post.data.rating)} {post.data.rating}/5</span>
                  )}
                </span>
                <span class="card-title">{post.data.title}</span>
                {post.data.description && <span class="card-desc">{post.data.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {notes.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Everyday Notes</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="post-grid">
        {notes.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.id}/`}>
              <span class="card-media">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt={post.data.coverAlt || ''}
                    width={640}
                    height={400}
                    loading="lazy"
                  />
                )}
              </span>
              <span class="card-body">
                <span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
                <span class="card-title">{post.data.title}</span>
                {post.data.description && <span class="card-desc">{post.data.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
