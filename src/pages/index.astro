---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import { Image } from 'astro:assets';
import { crayons } from '../utils/rating';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const [featured, ...rest] = posts;
const reviews = rest.filter((post) => post.data.type === 'review');
const notes = rest.filter((post) => post.data.type !== 'review');

const isReview = (post: (typeof posts)[number]) => post.data.type === 'review';
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE.tagline}</h1>
    <p class="hero-intro">
      Honest baby-gear reviews and quiet notes on patience, play, food, and sleep —
      from a girl dad with another kiddo on the way.
    </p>
  </section>

  {featured && (
    <a class="featured-card" href={`/posts/${featured.id}/`}>
      <span class="featured-media">
        {featured.data.cover && (
          <Image
            src={featured.data.cover}
            alt={featured.data.coverAlt || ''}
            width={1200}
            height={750}
            loading="eager"
          />
        )}
      </span>
      <span class="featured-body">
        {isReview(featured) ? (
          <span class="chip chip-review">Gear Review</span>
        ) : (
          <span class="chip chip-note">Latest Note</span>
        )}
        <span class="featured-date"><FormattedDate date={featured.data.pubDate} /></span>
        <span class="featured-title">{featured.data.title}</span>
        {featured.data.description && (
          <span class="featured-desc">{featured.data.description}</span>
        )}
        <span class="featured-cta">
          {isReview(featured) ? 'Read the review' : 'Read the note'} <span aria-hidden="true">→</span>
        </span>
      </span>
    </a>
  )}

  {reviews.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Baby Gear Reviews</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="post-grid">
        {reviews.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.id}/`}>
              <span class="card-media">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt={post.data.coverAlt || ''}
                    width={640}
                    height={400}
                    loading="lazy"
                  />
                )}
              </span>
              <span class="card-body">
                <span class="card-date">
                  <FormattedDate date={post.data.pubDate} />
                  {typeof post.data.rating === 'number' && (
                    <span> · {crayons(post.data.rating)} {post.data.rating}/5</span>
                  )}
                </span>
                <span class="card-title">{post.data.title}</span>
                {post.data.description && <span class="card-desc">{post.data.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {notes.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Field Notes</h2>
        <span class="section-rule" aria-hidden="true"></span>
      </div>
      <ul class="post-grid">
        {notes.map((post) => (
          <li>
            <a class="post-card" href={`/posts/${post.id}/`}>
              <span class="card-media">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt={post.data.coverAlt || ''}
                    width={640}
                    height={400}
                    loading="lazy"
                  />
                )}
              </span>
              <span class="card-body">
                <span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
                <span class="card-title">{post.data.title}</span>
                {post.data.description && <span class="card-desc">{post.data.description}</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
