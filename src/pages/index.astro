---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../consts';
import { Image } from 'astro:assets';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const [featured, ...rest] = posts;
const money = rest.filter((post) => post.data.type === 'money');
const reviews = rest.filter((post) => post.data.type === 'review');
const notes = rest.filter((post) => post.data.type === 'post');

const chip = (post: (typeof posts)[number]) =>
  post.data.type === 'review'
    ? { class: 'chip chip-review', label: 'Gear Review' }
    : post.data.type === 'money'
      ? { class: 'chip chip-money', label: 'Money Note' }
      : { class: 'chip chip-note', label: 'Note' };

// totals for the lane strip include the featured post's lane
const totalMoney = posts.filter((p) => p.data.type === 'money').length;
const totalReviews = posts.filter((p) => p.data.type === 'review').length;
const totalNotes = posts.filter((p) => p.data.type === 'post').length;
---

<BaseLayout title="Baby Gear Reviews & Money Notes for Working Parents">
  <section class="hero">
    <h1>
      The gear survives two kids. The math checks out. <em>The rest is
      parenting.</em>
    </h1>
    <p class="hero-intro">
      Long-term teardowns of gear we actually own, money math from five years of
      running a solo business, and quiet notes on the everyday - two kids, a
      bernedoodle, and the Bay Area.
    </p>
  </section>

  <nav class="lane-strip" aria-label="Browse by topic">
    <a class="lane-card" href="/money/">
      <span class="chip chip-money">Money Notes</span>
      <span class="lane-desc">Solo business math, real numbers, kid accounts</span>
      <span class="lane-count">{totalMoney} notes <span aria-hidden="true">→</span></span>
    </a>
    <a class="lane-card" href="/reviews/">
      <span class="chip chip-review">Gear Reviews</span>
      <span class="lane-desc">Years-owned teardowns, nothing borrowed</span>
      <span class="lane-count">{totalReviews} reviews <span aria-hidden="true">→</span></span>
    </a>
    <a class="lane-card" href="/notes/">
      <span class="chip chip-note">Everyday Notes</span>
      <span class="lane-desc">The unglamorous middle of parenting</span>
      <span class="lane-count">{totalNotes} notes <span aria-hidden="true">→</span></span>
    </a>
  </nav>

  {featured && (
    <a class="featured-card" href={`/posts/${featured.id}/`}>
      <span class="featured-media">
        {featured.data.cover && (
          <Image
            src={featured.data.cover}
            alt={featured.data.coverAlt || ''}
            width={1200}
            height={750}
            loading="eager"
          />
        )}
      </span>
      <span class="featured-body">
        <span class={chip(featured).class}>{chip(featured).label}</span>
        <span class="featured-date"><FormattedDate date={featured.data.pubDate} /></span>
        <span class="featured-title">{featured.data.title}</span>
        {featured.data.description && (
          <span class="featured-desc">{featured.data.description}</span>
        )}
        <span class="featured-cta">
          {featured.data.type === 'review' ? 'Read the review' : 'Read the note'} <span aria-hidden="true">→</span>
        </span>
      </span>
    </a>
  )}

  {money.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Money Notes</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <a class="section-more" href="/money/">See all {totalMoney} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="post-grid">
        {money.slice(0, 4).map((post) => (
          <li><PostCard post={post} /></li>
        ))}
      </ul>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Baby Gear Reviews</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <a class="section-more" href="/reviews/">See all {totalReviews} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="post-grid">
        {reviews.slice(0, 4).map((post) => (
          <li><PostCard post={post} /></li>
        ))}
      </ul>
    </section>
  )}

  {notes.length > 0 && (
    <section class="post-section">
      <div class="section-head">
        <h2>Everyday Notes</h2>
        <span class="section-rule" aria-hidden="true"></span>
        <a class="section-more" href="/notes/">See all {totalNotes} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="post-grid">
        {notes.slice(0, 4).map((post) => (
          <li><PostCard post={post} /></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .lane-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 0.5rem 0 2.5rem;
  }
  @media (max-width: 680px) {
    .lane-strip {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
  .lane-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.05rem 1.15rem 0.95rem;
    background: var(--card-bg);
    border: var(--card-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: var(--ink);
    border-bottom: none;
    transition: transform 220ms var(--ease), box-shadow 220ms var(--ease);
  }
  .lane-card:hover {
    color: var(--ink);
    border-bottom: none;
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .lane-desc {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .lane-count {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
  }
  .section-more {
    flex-shrink: 0;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    border-bottom: none;
  }
  .section-more:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
</style>
