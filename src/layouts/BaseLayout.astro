---
import { SITE } from '../consts';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '@fontsource/petrona/400.css';
import '@fontsource/petrona/500.css';
import '@fontsource/petrona/600.css';
import '@fontsource/petrona/400-italic.css';
import '@fontsource/petrona/500-italic.css';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
}

const {
  title,
  description = SITE.description,
  image,
  article = false,
  pubDate,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogImage = image ? new URL(image, canonicalURL).toString() : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdf8f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#221d19" />

    <meta name="p:domain_verify" content="5f80194879c4056f34d70412ed395782" />
  </head>
  <body>
    <header class="site-header">
      <div class="container row">
        <a href="/" class="brand">
          <img class="brand-mark" src="/favicon.svg" alt="" width="28" height="28" />
          <span>pastelloclub</span>
        </a>
        <nav class="primary" aria-label="Primary">
          <a href="/">Writing</a>
          <a href="/tools/">Tools</a>
          <a href="/about/">About</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container row">
        <span>© {new Date().getFullYear()} pastelloclub · made with love</span>
        <span>
          <a href="https://www.pinterest.com/pastelloclub/" target="_blank" rel="noopener noreferrer">Pinterest</a>
          {' · '}
          <a href="/rss.xml">RSS</a>
          {' · '}
          <a href="/privacy/">Privacy</a>
        </span>
      </div>
    </footer>
  </body>
</html>
