---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import { Image } from 'astro:assets';
import { crayons } from '../utils/rating';

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  readingTime?: number;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
  review?: {
    product?: string;
    rating: number;
    price?: number;
    buyLink?: string;
  };
  related?: {
    slug: string;
    title: string;
    cover?: string;
    coverAlt?: string;
    pubDate: Date;
    rating?: number;
  }[];
  relatedHeading?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  cover,
  coverAlt,
  readingTime,
  prev,
  next,
  review,
  related = [],
  relatedHeading,
} = Astro.props;

// Review structured data (star ratings in search results)
const reviewNode = review && {
  '@type': 'Review',
  itemReviewed: {
    '@type': 'Product',
    name: review.product ?? title,
    image: cover ? new URL(cover, SITE.url).toString() : undefined,
    ...(review.price != null && {
      offers: {
        '@type': 'Offer',
        price: review.price,
        priceCurrency: 'USD',
        url: review.buyLink,
      },
    }),
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: review.rating,
    bestRating: 5,
    worstRating: 1,
  },
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  datePublished: pubDate.toISOString(),
};

// Structured data for SEO
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: description,
      image: cover ? new URL(cover, SITE.url).toString() : undefined,
      datePublished: pubDate.toISOString(),
      dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
      author: {
        '@type': 'Person',
        name: SITE.author,
        email: SITE.email,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.title,
        url: SITE.url,
      },
      keywords: tags?.join(', '),
      ...(reviewNode && { about: reviewNode.itemReviewed }),
    },
    ...(reviewNode ? [reviewNode] : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${SITE.url}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: title,
          item: new URL(Astro.url.pathname, SITE.url).toString(),
        },
      ],
    },
  ],
};
---
<BaseLayout title={title} description={description} image={cover} article={true} pubDate={pubDate}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="reading">
    <header class="post-header">
      <div class="post-date">
        <FormattedDate date={pubDate} />
        {readingTime && <span> · {readingTime} min read</span>}
        {updatedDate && <span> · updated <FormattedDate date={updatedDate} /></span>}
      </div>
      <h1>{title}</h1>
      {description && <p class="post-desc">{description}</p>}
    </header>

    {cover && <Image src={cover} alt={coverAlt || ''} class="post-cover" width={1200} height={630} />}

    <div class="post-content">
      <slot />
    </div>

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    )}

    {related.length > 0 && (
      <aside class="related">
        <div class="section-head">
          <h2>{relatedHeading ?? 'Keep Reading'}</h2>
          <span class="section-rule" aria-hidden="true"></span>
        </div>
        <ul class="post-grid">
          {related.map((r) => (
            <li>
              <a class="post-card" href={`/posts/${r.slug}/`}>
                {r.cover && (
                  <span class="card-media">
                    <Image src={r.cover} alt={r.coverAlt || ''} width={640} height={400} loading="lazy" />
                  </span>
                )}
                <span class="card-body">
                  <span class="card-date">
                    <FormattedDate date={r.pubDate} />
                    {r.rating != null && <span> · {crayons(r.rating)} {r.rating}/5</span>}
                  </span>
                  <span class="card-title">{r.title}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    {(prev || next) && (
      <nav class="prev-next" aria-label="More posts">
        {prev ? (
          <a href={`/posts/${prev.slug}/`}>
            <small>← previous</small><br />
            {prev.title}
          </a>
        ) : <span />}
        {next ? (
          <a href={`/posts/${next.slug}/`} class="next">
            <small>next →</small><br />
            {next.title}
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
