---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE } from '../consts';
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description?: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  cover?: string;
  coverAlt?: string;
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const { title, description, pubDate, updatedDate, tags = [], cover, coverAlt, prev, next } = Astro.props;

// Structured data for SEO
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: description,
      image: cover ? new URL(cover, SITE.url).toString() : undefined,
      datePublished: pubDate.toISOString(),
      dateModified: updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
      author: {
        '@type': 'Person',
        name: SITE.author,
        email: SITE.email,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE.title,
        url: SITE.url,
      },
      keywords: tags?.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: SITE.url,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Writing',
          item: `${SITE.url}/`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: new URL(Astro.url.pathname, SITE.url).toString(),
        },
      ],
    },
  ],
};
---
<BaseLayout title={title} description={description} image={cover} article={true} pubDate={pubDate}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="reading">
    <header class="post-header">
      <div class="post-date">
        <FormattedDate date={pubDate} />
        {updatedDate && <span> · updated <FormattedDate date={updatedDate} /></span>}
      </div>
      <h1>{title}</h1>
      {description && <p class="post-desc">{description}</p>}
    </header>

    {cover && <Image src={cover} alt={coverAlt || ''} class="post-cover" width={1200} height={630} />}

    <div class="post-content">
      <slot />
    </div>

    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => <span class="tag">#{t}</span>)}
      </div>
    )}

    {(prev || next) && (
      <nav class="prev-next" aria-label="More posts">
        {prev ? (
          <a href={`/posts/${prev.slug}/`}>
            <small>← previous</small><br />
            {prev.title}
          </a>
        ) : <span />}
        {next ? (
          <a href={`/posts/${next.slug}/`} class="next">
            <small>next →</small><br />
            {next.title}
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</BaseLayout>
